{
    "name": "aryeo/webhooks",
    "description": "Sends recorded events as signed CloudEvents over HTTP.",
    "license": "MIT",
    "type": "library",
    "repositories": {
        "artifactory": {
            "type": "composer",
            "url": "https://artifactory.zgtools.net/artifactory/api/composer/listing-and-vendor-management-composer/",
            "only": ["aryeo/*", "zillow/*"]
        }
    },
    "require": {
        "php": "^8.5",
        "laravel/framework": "^12.37 || ^13",
        "aryeo/event-log": "0.0.12",
        "aryeo/eloquent-state-machines": "0.0.35",
        "cloudevents/sdk-php": "^1.2",
        "nesbot/carbon": "^3.11",
        "symfony/http-foundation": "^7.0 || ^8.0"
    },
    "require-dev": {
        "aryeo/tooling-laravel": "0.0.43",
        "phpstan/phpstan": "^2.1",
        "nikic/php-parser": "^5.0",
        "orchestra/testbench": "^10.6 || ^11",
        "brianium/paratest": "^7.14",
        "phpunit/phpunit": "^12.4.1 || ^13",
        "pestphp/pest": "^4.1",
        "orchestra/testbench-core": "^10.7 || ^11",
        "nunomaduro/collision": "<8.9.4"
    },
    "autoload": {
        "psr-4": {
            "Support\\": "src/Support"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Justin Seliga",
            "email": "justinsel@zillowgroup.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "aryeo/tooling-laravel": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Support\\Webhooks\\Providers\\Provider",
                "Support\\Webhooks\\Endpoints\\Providers\\Provider",
                "Support\\Webhooks\\Subscriptions\\Providers\\Provider"
            ]
        },
        "tooling": {
            "phpstan": {
                "config": {
                    "paths": [
                        "src"
                    ]
                }
            },
            "rector": {
                "config": {
                    "paths": [
                        "src"
                    ]
                }
            },
            "pint": {
                "config": {
                    "paths": [
                        "src",
                        "tests"
                    ]
                }
            }
        }
    }
}
